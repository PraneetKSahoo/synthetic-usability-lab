# Hugging Face access token — required to download the gated Gemma 4 model weights.
# Get one at https://huggingface.co/settings/tokens (read access is enough).
# Copy this file to `.env` and fill in your real token, or export it directly:
#   export HF_TOKEN=hf_your_token_here      (macOS/Linux)
#   $env:HF_TOKEN = "hf_your_token_here"    (Windows PowerShell)
HF_TOKEN=
